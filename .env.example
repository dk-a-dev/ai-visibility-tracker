# Environment variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required for ChatGPT integration)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (required for Claude integration)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Perplexity API Key (optional for Sonar with web search)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Gemini API Key (optional for Google AI integration with grounding)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_visibility

# Redis
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ChatGPT Web Scraping (optional for bonus feature)
CHATGPT_SESSION_TOKEN=

# Rate Limiting
OPENAI_RPM=60
ANTHROPIC_RPM=50
GEMINI_RPM=60
PERPLEXITY_RPM=50
